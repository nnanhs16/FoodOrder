<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7F7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FOOD."
                    android:textColor="#111111"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnCart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:text="🛒"
                    android:textSize="23sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Khám phá hương vị"
                android:textColor="#111111"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tìm kiếm món ăn yêu thích của bạn"
                android:textColor="#888888"/>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:hint="Tìm kiếm món ăn..."
                android:padding="14dp"
                android:singleLine="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Danh mục món ăn"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/catAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="65dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:text="Tất cả"
                        android:textColor="#111111"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/catBurger"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="65dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:text="Burger"
                        android:textColor="#111111"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/catPizza"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="65dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:text="Pizza"
                        android:textColor="#111111"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/catChicken"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="65dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:text="Gà rán"
                        android:textColor="#111111"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/catNoodles"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="65dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:background="#FFFFFF"
                        android:text="Mì"
                        android:textColor="#111111"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Món ăn phổ biến"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/foodContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Trang chủ"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/btnOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;Đơn hàng"
            android:textColor="#777777"/>

        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙&#10;Tài khoản"
            android:textColor="#777777"/>
    </LinearLayout>
</LinearLayout>
